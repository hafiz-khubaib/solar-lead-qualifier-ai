    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const body = item.json.body || {};\n  \n  // Phone se '+' sign aur extra spaces remove karein taake sheet ke format se match ho\n  let formattedPhone = body.phone ? body.phone.toString().replace('+', '').trim() : '';\n  \n  const safePhone = formattedPhone !== '' \n    ? formattedPhone \n    : `MISSING_PHONE_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;\n    \n  const safeEmail = body.email && body.email.trim() !== '' \n    ? body.email.trim() \n    : `MISSING_EMAIL_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;\n\n  item.json.cleanPhone = safePhone;\n  item.json.cleanEmail = safeEmail;\n}\n\nreturn $input.all();"
      },
